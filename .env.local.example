# ── R2: Photos Bucket ──────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=2d-personal
R2_ENDPOINT=https://[account-id].r2.cloudflarestorage.com

# ── R2: EcoFlow History Bucket (separate credentials) ─────────────────────────
ECOFLOW_R2_ACCESS_KEY_ID=your_ecoflow_r2_access_key_id
ECOFLOW_R2_SECRET_ACCESS_KEY=your_ecoflow_r2_secret_access_key

# ── EcoFlow API ────────────────────────────────────────────────────────────────
ECOFLOW_ACCESS_KEY=your_ecoflow_access_key
ECOFLOW_SECRET_KEY=your_ecoflow_secret_key
ECOFLOW_DEVICE_SN=your_device_serial_number

# ── Admin Auth ─────────────────────────────────────────────────────────────────
ECOFLOW_ADMIN_USERNAME=admin
ECOFLOW_ADMIN_PASSWORD_HASH=sha256_hash_of_your_password
ECOFLOW_ADMIN_SECRET=any_random_string_for_api_auth

# ── PG&E Green Button (optional) ──────────────────────────────────────────────
# PGE_CLIENT_ID=your_pge_client_id
# PGE_CLIENT_SECRET=your_pge_client_secret
